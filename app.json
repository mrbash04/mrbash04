{
  "expo": {
    "name": "TowTruckTest2",
    "slug": "TowTruckTest2",
    "version": "1.0.0",
    "scheme": "towtrucktest2",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location.",
          "locationAlwaysPermission": "Allow $(PRODUCT_NAME) to use your location.",
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDPH-Ha0301BHUtNs8jmWG8fQW4Dy3XFDo"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "ios": {
      "config": {
        "googleMapsApiKey": "AIzaSyDPH-Ha0301BHUtNs8jmWG8fQW4Dy3XFDo"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to provide tow truck services.",
        "NSLocationAlwaysUsageDescription": "This app needs access to your location to provide tow truck services.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to your location to provide tow truck services."
      }
    },
    "web": {
    }
  }
}
